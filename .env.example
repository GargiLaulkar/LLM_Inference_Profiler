# .env.example - Copy to .env and fill in values before running docker compose
# DO NOT commit .env to git (it's in .gitignore)

# ─── vLLM Server ─────────────────────────────────────────────────────────────
VLLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
VLLM_PORT=8000
VLLM_MAX_MODEL_LEN=1024
VLLM_GPU_MEMORY_UTILIZATION=0.65
HF_TOKEN=

# ─── Prometheus ───────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL=5s

# ─── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_PORT=3000
# Set a strong password - NOT the Grafana default
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_strong_password_here

# ─── Profiler Exporter (teammates will enable) ───────────────────────────────
PROFILER_EXPORTER_PORT=9101

# ─── GPU Collector (teammates will enable) ───────────────────────────────────
GPU_COLLECTOR_PORT=9102
