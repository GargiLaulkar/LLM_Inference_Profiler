FROM python:3.13-slim

WORKDIR /workspace

RUN pip install --no-cache-dir \
    fastapi==0.136.1 \
    uvicorn==0.53.0 \
    aiohttp==3.13.5 \
    pyyaml==6.0.2

COPY config.yaml /workspace/config.yaml
COPY llm_profiler /workspace/llm_profiler

ENV PYTHONPATH=/workspace

ENTRYPOINT ["python", "-m", "llm_profiler.gateway.main"]

