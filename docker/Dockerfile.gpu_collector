# M3 GPU Telemetry Collector Dockerfile
# Base: python:3.12-slim
FROM python:3.12-slim

WORKDIR /workspace

# Install pinned dependencies for M3 collector
RUN pip install --no-cache-dir \
    prometheus_client==0.26.0 \
    nvidia-ml-py==13.615.71 \
    pyyaml==6.0.2

# Copy only the collector script and configuration file
COPY llm_profiler/collectors/gpu_collector.py /workspace/gpu_collector.py
COPY config.yaml /workspace/config.yaml

# Expose Prometheus scraping endpoint
EXPOSE 9102

# Run collector daemon unbuffered
ENTRYPOINT ["python", "-u", "gpu_collector.py"]
